# Credenciales del cliente NEAR del enjambre (nunca subir .env al repo)
# Cuenta raiz del mercado (testnet) y su clave privada full-access
NEAR_ACCOUNT_ID=publisher.testnet
NEAR_PRIVATE_KEY=ed25519:XXXX
# Cuenta del contrato del mercado desplegado en testnet
NEAR_CONTRACT_ID=market.publisher.testnet
# RPC de testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
# Binario near-sandbox local (opcional; sin él, sandbox:round y client_worker hacen SKIP)
# NEAR_SANDBOX_BIN_PATH=/ruta/a/near-sandbox
