# .env.example v2.0 - NEAR testnet credentials for the swarm client (copy to .env; .env is git-ignored, keep it mode 600)
# Easiest: `npm run testnet:account` creates a faucet-funded account and writes .env for you (the key is never printed).
# Root testnet account (publisher) and its full-access key
NEAR_ACCOUNT_ID=<your-account>.testnet
NEAR_PRIVATE_KEY=ed25519:<private-key>
# Market contract: a sub-account of NEAR_ACCOUNT_ID
NEAR_CONTRACT_ID=market.<your-account>.testnet
# Public testnet RPC (rpc.testnet.near.org is deprecated and rate-limited)
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Optional local near-sandbox binary (without it, sandbox:round and client:sandbox print SKIP)
# NEAR_SANDBOX_BIN_PATH=/path/to/near-sandbox
