{
  "name": "swarm",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic swarm simulator + vitest key-figure lock",
  "scripts": {
    "test": "vitest run",
    "sim": "python3 deterministic_simulator.py",
    "sandbox:round": "node scripts/sandbox_round.mjs && node scripts/client_worker.mjs",
    "sandbox:multi": "node scripts/multi_round.mjs",
    "verify:swarm": "vitest run && python3 deterministic_simulator.py && node scripts/sandbox_round.mjs && node scripts/client_worker.mjs",
    "client:sandbox": "node scripts/client_worker.mjs",
    "client:testnet": "node --env-file=.env scripts/client_testnet.mjs",
    "sim:horizon": "python3 scripts/horizon_sweep.py",
    "sim:multiseed": "python3 scripts/multiseed_ci.py",
    "reproduce": "python3 scripts/reproduce_checks.py",
    "reproduce:check": "python3 scripts/reproduce_checks.py --no-regen",
    "market:plan": "node scripts/market_plan_emit.mjs",
    "repro:fuente": "python3 scripts/reproducibilidad_desde_fuente.py",
    "release": "python3 scripts/package_release.py",
    "testnet:deploy": "node --env-file=.env scripts/deploy_and_seed_testnet.mjs",
    "testnet:market": "node --env-file=.env scripts/testnet_market_rounds.mjs",
    "testnet:account": "node scripts/create_testnet_account.mjs",
    "verify:testnet": "node scripts/verify_testnet_market.mjs",
    "verify:testnet:f": "node scripts/verify_testnet_market.mjs out/testnet_market-f.json",
    "testnet:guard": "node scripts/prove_storage_guard_testnet.mjs",
    "testnet:reregister": "node --env-file=.env scripts/prove_reregistration_testnet.mjs",
    "testnet:zeroprice": "node --env-file=.env scripts/prove_zero_price_testnet.mjs",
    "testnet:preflight": "node scripts/preflight_testnet_tranche.mjs",
    "prove:round-spam": "node scripts/prove_round_spam_testnet.mjs",
    "baseline:compare": "python3 scripts/baseline_compare.py",
    "testnet:costs": "node scripts/testnet_costs.mjs",
    "adversarial:view": "node scripts/adversarial_view.mjs",
    "sustain:project": "node scripts/scale_projection.mjs",
    "verify:figures": "node scripts/verify_figures.mjs",
    "verify:all": "vitest run && node scripts/verify_figures.mjs && python3 scripts/reproduce_checks.py --no-regen",
    "trace:repricing": "node scripts/repricing_trace.mjs out/testnet_market-f.json"
  },
  "devDependencies": {
    "near-kit": "^0.20.2",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "near-api-js": "^7.4.0"
  }
}
